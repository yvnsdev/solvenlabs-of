RewriteEngine On

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://formsubmit.co; script-src 'self' 'sha256-3cdcbWoBiCc3VQwRz3FplX2bycXjC/BefXYaRuJCqYQ=' 'sha256-6+PMNV4PVN31naWUEyP/eLxhnSRKlHX5rGMCk4wtHCA=' 'sha256-8IunCu0z4FnzVSM/VTHFDGBCFTNPJuHdkmAUdGxjRgY=' 'sha256-BHpmzURi/mZK0m1HBoIccRGazZKRa1Lryxt7v4xyv2w=' 'sha256-RNSwuYLCujRdEE8z7XcFjz+vBt8YnEW3+56TKV7vxVI=' 'sha256-TiPh3fdQRZCG/RjIQXFP2TtQd5JA4QqG6b1Xr+0i+/8=' 'sha256-Upn8rtj7Mk5W2zQ8dHMuFjD23lDr6qqUAaGAXGVrLnM=' 'sha256-WdH941qJcBMEuISa6GfwA6sa7Jgg5di23VIQu0xtizg=' 'sha256-XuhUQihVDofIZ5YwbGSwiq+8HfPBj0SuF1W2UXQST6k=' 'sha256-aK1FIRCdukCwM73CEA+3E7JuCe+cf+lOU8X1j/ictls=' 'sha256-gwv5F/uCVWfdP4Z4W6feLl+0vUy6UoTskXuCqcwfwtU=' 'sha256-sMVWsj6c9EdxTeUq25DICCsf+lfYxDN60hsO7JUwrRc=' 'sha256-y1ay3xJzhTK5f02M+DWpc9e/22rYcD4UZveJrJZlyrs=' https://unpkg.com https://cdnjs.cloudflare.com https://esm.sh https://challenges.cloudflare.com https://api.mercadopublico.cl; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https: wss://oxyhuxnkhogmuholomis.supabase.co; frame-src https://challenges.cloudflare.com https://www.google.com https://calendar.google.com; worker-src 'self'; manifest-src 'self'; media-src 'self'; upgrade-insecure-requests;"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
</IfModule>

# Rutas limpias del dashboard y acceso privado
RewriteRule ^dashboard(?:/.*)?$ dashboard.html [L]
RewriteRule ^login/?$ dashboard.html [L]

# Perfil y secciones con URL propia
RewriteRule ^tomas-yevenes(?:/(?:trayectoria|experiencia|proyectos|catalogo|reconocimientos|certificaciones|formacion))?/?$ tomas-yevenes.html [L]

# Si la URL no es archivo real
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Redirigir todo a index.html
RewriteRule ^ index.html [L]
